{
  "name": "hacker-news-newest-test",
  "version": "1.0.0",
  "private": true,
  "description": "Validate the chronological order of the first 100 Hacker News newest articles",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
